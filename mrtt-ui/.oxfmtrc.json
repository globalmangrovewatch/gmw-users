{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSameLine": true,
  "jsxSingleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": ["build/**", "coverage/**", "public/**", "pnpm-lock.yaml"]
}
