    "@turf/convex": "^6.5.0",
    "@types/react": "^18.0.5",
    "@types/react-dom": "^18.0.0",
    "axios": "^0.27.2",
    "buffer": "^6.0.3",
    "date-fns": "^2.28.0",
    "express": "^5.1.0",
    "geojson-prop-types": "^0.2.0",
    "js-file-download": "^0.4.12",
    "luxon": "^2.5.0",
    "mapbox-gl": "^2.8.2",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
