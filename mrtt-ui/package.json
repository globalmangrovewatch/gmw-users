{
  "name": "mrtt-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@hookform/resolvers": "7.0.6",
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@mui/base": "5.0.0-beta.70",
    "@mui/icons-material": "5.17.1",
    "@mui/material": "5.17.1",
    "@mui/system": "7.0.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.107.1",
    "@tmcw/togeojson": "7.1.3",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/bbox-polygon": "7.4.0",
    "@turf/convex": "7.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "2.30.0",
    "mapbox-gl": "3.34.2",
    "next": "16.4.6",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "react-hook-form": "7.92.0",
    "react-icons": "5.7.0",
    "react-map-gl": "8.1.3",
    "shpjs": "6.2.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "heroku-postbuild": "pnpm build && rm -rf .next/cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "next typegen && tsc --noEmit && tsc --noEmit -p tests",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "prepare": "cd .. && husky .husky || true"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/geojson": "7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "1.4.9",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "22.15.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "fsevents"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
