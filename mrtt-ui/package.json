{
  "name": "mrtt-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@hookform/resolvers": "5.9.1",
    "@mapbox/mapbox-gl-draw": "1.5.0",
    "@mui/base": "5.0.0-beta.70",
    "@mui/icons-material": "5.17.1",
    "@mui/material": "5.17.1",
    "@mui/system": "7.0.2",
    "@mui/x-date-pickers": "5.0.20",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.74.11",
    "@tmcw/togeojson": "7.1.2",
    "@turf/area": "6.5.0",
    "@turf/bbox": "6.5.0",
    "@turf/bbox-polygon": "6.5.0",
    "@turf/convex": "6.5.0",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "date-fns": "2.30.0",
    "geojson-prop-types": "0.2.0",
    "luxon": "2.5.2",
    "mapbox-gl": "2.15.0",
    "next": "16.3.8",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.56.1",
    "react-map-gl": "7.1.9",
    "react-mui-dropzone": "4.0.7",
    "react-toastify": "9.1.3",
    "shpjs": "6.2.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "heroku-postbuild": "pnpm build && rm -rf .next/cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "next typegen && tsc --noEmit && tsc --noEmit -p tests",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "prepare": "cd .. && husky .husky || true"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "5.8.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "22.15.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "fsevents"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
