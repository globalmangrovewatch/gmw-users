# Load nvm and the project's Node (mrtt-ui/.nvmrc) so hooks also work from GUI git clients.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
cd mrtt-ui || exit 1
command -v nvm >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1

# `pnpm exec` (unlike `pnpm run`) does not enforce engine-strict, so a nearby Node still works.
pnpm exec lint-staged
